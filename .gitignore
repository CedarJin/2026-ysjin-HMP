# --- pipeline A only (HMGI gene-catalog search / counts / TPM) ---
# Read-prep scripts are shared with pipeline B (B consumes
# results/hmp_active_gus/reads and repaired_reads for SRS023176):
#   extract_hmp_read_pair.py, repair_hmp_fastq_pairs.py,
#   validate_hmp_fastq_pairs.py, hmp_sequence_dedup_trim.cpp,
#   submit_SRS023176_from_sra_active_gus.sbatch,
#   submit_SRS023176_hmp_preprocess_active_gus.sbatch
scripts/prepare_hmgi_gene_features.py
scripts/count_hmp_gene_alignments.py
scripts/summarize_hmp_active_gus_hits.py
scripts/calculate_hmp_active_gus_abundance.py
scripts/merge_hmp_active_gus_abundance.py
scripts/check_fastq_after_read.py

